---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, align = 'left' } = Astro.props;
---
<div class={`reveal ${align === 'center' ? 'mx-auto max-w-2xl text-center' : ''}`}>
  {eyebrow && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-cyan-400">{eyebrow}</p>}
  <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base text-mist">{description}</p>}
</div>
