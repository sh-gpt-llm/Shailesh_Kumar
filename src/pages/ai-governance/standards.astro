---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { STANDARDS, STANDARDS_NOTE, LANDSCAPE_INSIGHT, STANDARDS_FAQ } from '../../data/ai-governance/standards';
import { CONTROL_THEMES } from '../../data/ai-governance/model';

const pageUrl = new URL('/ai-governance/standards/', Astro.site).href;

const regions = [...new Set(STANDARDS.map((s) => s.region))];
const natures = [...new Set(STANDARDS.map((s) => s.nature))];
const themeName = (id: string) => CONTROL_THEMES.find((t) => t.id === id)?.name ?? id;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'AI governance standards and regulation: the global landscape',
    description:
      'A register of the AI standards, laws, treaties, frameworks and regulator guidance that shape AI governance across the EU, UK, US, Asia-Pacific and internationally — and how they relate to one another.',
    url: pageUrl,
    author: { '@type': 'Person', name: 'Shailesh Kumar', url: 'https://vantessence.com/' },
    about: ['AI regulation', 'AI standards', 'EU AI Act', 'ISO/IEC 42001', 'NIST AI RMF', 'AI governance'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'AI governance standards and regulations',
    numberOfItems: STANDARDS.length,
    itemListElement: STANDARDS.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${s.name} — ${s.body}`,
      description: s.covers,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: STANDARDS_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'AI Governance', item: new URL('/ai-governance/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Standards', item: pageUrl },
    ],
  },
];
---
<BaseLayout
  title="AI governance standards and regulation — the global landscape"
  description="A register of the AI laws, treaties, standards, frameworks and regulator guidance across the EU, UK, US, Asia-Pacific, Canada and internationally — what each covers, what kind of instrument it is, and which controls it supports."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <article class="mx-auto max-w-4xl px-6 py-16 sm:py-24">
    <nav class="text-xs text-mist">
      <a href="/ai-governance/" class="transition hover:text-white">AI Governance</a>
      <span class="mx-2 text-mist/50">/</span>
      <span class="text-white">Standards</span>
    </nav>

    <p class="mt-8 text-xs font-semibold uppercase tracking-[0.4em] text-amber-400">The landscape</p>
    <h1 class="mt-4 font-display text-3xl font-semibold text-white sm:text-5xl">
      Every regime that <span class="gradient-text">reaches you</span>
    </h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-mist">
      {STANDARDS.length} instruments across {regions.length} regions — binding law, treaties, technical standards,
      voluntary frameworks, regulator guidance and industry resources. What each covers, what kind of thing it is, and
      which of the nine control themes it supports.
    </p>
    <p class="mt-5 rounded-2xl border border-white/10 bg-white/[0.03] p-4 text-xs leading-relaxed text-mist/80">{STANDARDS_NOTE}</p>

    <section class="mt-12">
      <h2 class="font-display text-2xl font-semibold text-white">Four things worth knowing first</h2>
      <dl class="mt-5 space-y-5">
        {LANDSCAPE_INSIGHT.map((l) => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-5">
            <dt class="font-display text-base font-semibold text-white">{l.heading}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-mist">{l.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-14">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-display text-2xl font-semibold text-white">The register</h2>
        <p class="text-xs text-mist"><span id="std-count">{STANDARDS.length}</span> shown</p>
      </div>

      <div class="no-print mt-5 space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-mist/60">Region</span>
          <button data-filter="region" data-value="all" class="std-chip rounded-full border border-transparent bg-gradient-to-r from-violet-500 to-cyan-400 px-3 py-1.5 text-xs font-semibold text-ink">All</button>
          {regions.map((r) => (
            <button data-filter="region" data-value={r} class="std-chip rounded-full border border-white/10 px-3 py-1.5 text-xs font-semibold text-mist transition hover:bg-white/10 hover:text-white">{r}</button>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-mist/60">Type</span>
          <button data-filter="nature" data-value="all" class="std-chip rounded-full border border-transparent bg-gradient-to-r from-violet-500 to-cyan-400 px-3 py-1.5 text-xs font-semibold text-ink">All</button>
          {natures.map((n) => (
            <button data-filter="nature" data-value={n} class="std-chip rounded-full border border-white/10 px-3 py-1.5 text-xs font-semibold text-mist transition hover:bg-white/10 hover:text-white">{n}</button>
          ))}
        </div>
      </div>

      <div class="mt-6 space-y-4">
        {STANDARDS.map((s) => (
          <article class="std-card rounded-2xl border border-white/10 bg-white/[0.02] p-5" data-region={s.region} data-nature={s.nature}>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-display text-lg font-semibold text-white">{s.name}</h3>
              <span class="text-xs text-mist">{s.body}</span>
            </div>
            <div class="mt-2 flex flex-wrap gap-1.5">
              <span class="rounded-full bg-violet-500/20 px-2.5 py-1 text-[10px] font-semibold text-violet-200">{s.region}</span>
              <span class="rounded-full bg-white/10 px-2.5 py-1 text-[10px] font-semibold text-mist">{s.nature}</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-mist">{s.covers}</p>
            <p class="mt-2 text-sm leading-relaxed text-mist"><strong class="text-white">So what —</strong> {s.soWhat}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {s.themes.map((t) => (
                <span class="rounded-full border border-white/10 px-2.5 py-1 text-[10px] text-mist/80">{themeName(t)}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
      <p id="std-empty" class="mt-6 hidden rounded-2xl border border-dashed border-white/15 p-5 text-sm text-mist">
        Nothing matches that combination. Clear one of the filters.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-display text-2xl font-semibold text-white">Common questions</h2>
      <dl class="mt-5 space-y-6">
        {STANDARDS_FAQ.map((f) => (
          <div>
            <dt class="font-display text-base font-semibold text-white">{f.q}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-mist">{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="mt-14 flex flex-wrap items-center gap-4">
      <a href="/ai-governance/" class="rounded-full bg-gradient-to-r from-violet-500 to-cyan-400 px-6 py-3 text-sm font-semibold text-ink transition hover:opacity-90">
        Classify a use case
      </a>
      <a href="/ai-governance/framework/" class="text-sm text-mist underline decoration-dotted transition hover:text-white">The operating model</a>
      <a href="/ai-governance/data.json" download="ai-governance-model.json" class="text-sm text-mist underline decoration-dotted transition hover:text-white">Download the data</a>
    </div>

    <p class="mt-10 text-xs leading-relaxed text-mist/60">
      A map of the landscape, not legal advice. Scope, status and effective dates change — verify against the primary
      source before relying on any of it.
    </p>
  </article>
</BaseLayout>

<script>
  const state = { region: 'all', nature: 'all' };
  const cards = [...document.querySelectorAll<HTMLElement>('.std-card')];
  const count = document.getElementById('std-count');
  const empty = document.getElementById('std-empty');

  function apply() {
    let shown = 0;
    for (const card of cards) {
      const ok =
        (state.region === 'all' || card.dataset.region === state.region) &&
        (state.nature === 'all' || card.dataset.nature === state.nature);
      card.classList.toggle('hidden', !ok);
      if (ok) shown++;
    }
    if (count) count.textContent = String(shown);
    empty?.classList.toggle('hidden', shown > 0);
  }

  for (const btn of document.querySelectorAll<HTMLElement>('[data-filter]')) {
    btn.addEventListener('click', () => {
      const group = btn.dataset.filter as 'region' | 'nature';
      state[group] = btn.dataset.value!;
      for (const peer of document.querySelectorAll<HTMLElement>(`[data-filter="${group}"]`)) {
        const on = peer === btn;
        peer.className = on
          ? 'std-chip rounded-full border border-transparent bg-gradient-to-r from-violet-500 to-cyan-400 px-3 py-1.5 text-xs font-semibold text-ink'
          : 'std-chip rounded-full border border-white/10 px-3 py-1.5 text-xs font-semibold text-mist transition hover:bg-white/10 hover:text-white';
      }
      apply();
    });
  }
</script>
