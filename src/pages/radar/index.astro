---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INDUSTRIES } from '../../data/radar/industries';
import { RINGS, QUADRANTS } from '../../data/radar/types';
import { routeFor } from '../../data/radar/routes';
import { CANONICAL_THEMES, canonicalKeyFor } from '../../data/radar/canonical';

const totalTech = INDUSTRIES.reduce((n, i) => n + i.technologies.length, 0);
const ringLabel = (id: string) => RINGS.find((r) => r.id === id)?.label ?? id;
const pageUrl = new URL('/radar/', Astro.site).href;

const crossIndustry = CANONICAL_THEMES.map((theme) => ({
  theme,
  entries: INDUSTRIES.flatMap((ind) => {
    const tech = ind.technologies.find((t) => canonicalKeyFor(t.name) === theme.key);
    return tech ? [{ ind, tech }] : [];
  }),
})).filter((r) => r.entries.length >= 2);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Emerging Technology & Innovation Radar',
    description: `An independent, industry-agnostic technology radar covering ${totalTech} technologies across ${INDUSTRIES.length} industries, each placed in Adopt, Trial, Assess or Hold.`,
    url: pageUrl,
    creator: { '@type': 'Person', name: 'Shailesh Kumar', url: 'https://vantessence.com/' },
    datePublished: INDUSTRIES[0].edition.published,
    version: INDUSTRIES[0].edition.label,
    keywords: ['technology radar', 'emerging technology', 'enterprise architecture', 'AI strategy', ...INDUSTRIES.map((i) => i.name)],
    distribution: [
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: new URL('/radar/data.json', Astro.site).href },
    ],
    hasPart: INDUSTRIES.map((i) => ({
      '@type': 'Dataset',
      name: `${i.name} Technology Radar`,
      description: i.tagline,
      url: new URL(`/radar/?industry=${i.slug}`, Astro.site).href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the Emerging Technology & Innovation Radar?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `An independent radar that places ${totalTech} technologies across ${INDUSTRIES.length} industries into four rings — Adopt, Trial, Assess and Hold — with a written brief explaining each placement.`,
        },
      },
      {
        '@type': 'Question',
        name: 'What do the rings mean?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Adopt means proven and low-risk, invest now. Trial means worth piloting on a real project. Assess means worth understanding but not yet committing. Hold means proceed with caution or de-prioritise.',
        },
      },
      {
        '@type': 'Question',
        name: 'Which industries does the radar cover?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${INDUSTRIES.map((i) => i.name).join(', ')}. Each industry has its own independently curated set of technologies.`,
        },
      },
      {
        '@type': 'Question',
        name: 'Who writes the radar?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Shailesh Kumar, an enterprise architect specialising in AI strategy and digital transformation. It is independent, and not affiliated with any employer or vendor.',
        },
      },
    ],
  },
];
---
<BaseLayout
  title="Emerging Technology & Innovation Radar"
  description={`An industry-agnostic Emerging Technology & Innovation Radar by Shailesh Kumar — ${totalTech} technologies across ${INDUSTRIES.length} industries, mapped to Adopt, Trial, Assess and Hold.`}
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  {/* Netlify detects forms in the static build output; the live form is rendered client-side. */}
  <form name="radar-subscribe" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="hidden" name="form-name" value="radar-subscribe" />
    <input type="email" name="email" />
    <input name="bot-field" />
  </form>

  {/*
    Rendered at build time so crawlers and AI assistants can read the whole radar
    without executing JavaScript. The interactive app replaces this on mount.
  */}
  <div id="radar-app">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="text-xs font-semibold uppercase tracking-[0.4em] text-amber-400">Emerging Technology &amp; Innovation Radar</p>
      <h1 class="mt-4 font-display text-3xl font-semibold text-white sm:text-5xl">
        {totalTech} technologies. <span class="gradient-text">{INDUSTRIES.length} industries.</span> One map.
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-mist">
        An independent radar placing each technology into Adopt, Trial, Assess or Hold — with a written brief
        explaining why.
      </p>

      <h2 class="mt-12 font-display text-sm font-semibold uppercase tracking-[0.3em] text-mist">Methodology</h2>
      <p class="mt-2 text-sm text-mist">
        <a href="/radar/how-it-works/" class="underline decoration-dotted">How to read this radar</a> — the full guide
        to rings, quadrants and how placements are decided.
      </p>
      <dl class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div><dt class="font-semibold text-white">Adopt</dt><dd class="text-sm text-mist">Proven and low-risk; invest now.</dd></div>
        <div><dt class="font-semibold text-white">Trial</dt><dd class="text-sm text-mist">Worth piloting on a real project.</dd></div>
        <div><dt class="font-semibold text-white">Assess</dt><dd class="text-sm text-mist">Worth understanding, not yet committing.</dd></div>
        <div><dt class="font-semibold text-white">Hold</dt><dd class="text-sm text-mist">Proceed with caution, or de-prioritise.</dd></div>
      </dl>
      <p class="mt-3 text-sm text-mist">Quadrants: {QUADRANTS.map((q) => q.name).join(' · ')}</p>

      {INDUSTRIES.map((industry) => (
        <section class="mt-14">
          <h2 class="font-display text-2xl font-semibold text-white">{industry.name}</h2>
          <p class="mt-1.5 max-w-3xl text-sm text-mist">{industry.tagline}</p>
          <p class="mt-1 text-xs text-mist/70">{industry.edition.label} · published {industry.edition.published}</p>

          <h3 class="mt-5 text-xs font-semibold uppercase tracking-wide text-cyan-400">Themes this edition</h3>
          <ul class="mt-2 space-y-1.5">
            {industry.themes.map((t) => (
              <li class="text-sm text-mist"><strong class="text-white">{t.title}</strong> — {t.description}</li>
            ))}
          </ul>

          {RINGS.map((ring) => {
            const items = industry.technologies.filter((t) => t.ring === ring.id);
            return items.length > 0 ? (
              <div class="mt-5">
                <h3 class="text-xs font-semibold uppercase tracking-wide text-mist">
                  {ring.label} <span class="text-mist/60">{items.length}</span>
                </h3>
                <ul class="mt-2 grid gap-2 sm:grid-cols-2">
                  {items.map((t) => (
                    <li class="rounded-xl border border-white/10 p-3">
                      <a href={routeFor(industry.slug, t.name)} class="text-sm font-semibold text-white hover:underline">{t.name}</a>
                      <p class="mt-1 text-xs italic text-mist">{t.summary}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null;
          })}

          <h3 class="mt-5 text-xs font-semibold uppercase tracking-wide text-mist">On the periphery — watchlist</h3>
          <ul class="mt-2 grid gap-1.5 sm:grid-cols-2">
            {industry.watchlist.map((w) => (
              <li class="text-xs text-mist"><strong class="text-white">{w.name}</strong> — {w.blurb}</li>
            ))}
          </ul>

          <h3 class="mt-5 text-xs font-semibold uppercase tracking-wide text-mist">Editor's note</h3>
          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-mist">{industry.editorsNote}</p>
        </section>
      ))}

      <section class="mt-14">
        <h2 class="font-display text-2xl font-semibold text-white">The same technology, across industries</h2>
        <p class="mt-1.5 max-w-3xl text-sm text-mist">
          {crossIndustry.length} cross-cutting themes appear in more than one industry — often in different rings.
        </p>
        <ul class="mt-4 space-y-2">
          {crossIndustry.map(({ theme, entries }) => (
            <li class="rounded-xl border border-white/10 p-3">
              <strong class="text-sm text-white">{theme.label}</strong>
              <p class="mt-1 text-xs text-mist">{theme.blurb}</p>
              <p class="mt-1.5 text-xs text-mist">
                {entries.map((e, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={routeFor(e.ind.slug, e.tech.name)} class="hover:text-white">
                      {e.ind.name}: <strong>{ringLabel(e.tech.ring)}</strong>
                    </a>
                  </>
                ))}
              </p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { initRadarApp } from '../../scripts/radar-app';
  initRadarApp();
</script>
