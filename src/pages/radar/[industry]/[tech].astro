---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { techRoutes, routeFor, slugify } from '../../../data/radar/routes';
import { INDUSTRIES } from '../../../data/radar/industries';
import { QUADRANTS, RINGS, MOMENTUM } from '../../../data/radar/types';
import { canonicalKeyFor, themeByKey } from '../../../data/radar/canonical';

export function getStaticPaths() {
  return techRoutes().map(({ industry, tech, slug }) => ({
    params: { industry: industry.slug, tech: slug },
    props: { industry, tech },
  }));
}

const { industry, tech } = Astro.props;

const ringLabel = RINGS.find((r) => r.id === tech.ring)?.label ?? tech.ring;
const quadrant = QUADRANTS.find((q) => q.id === tech.quadrant);
const momentum = MOMENTUM.find((m) => m.id === tech.momentum);

const byId = new Map(industry.technologies.map((t) => [t.id, t]));
const dependsOn = (tech.dependsOn ?? []).map((id) => byId.get(id)).filter(Boolean);
const enables = industry.technologies.filter((t) => (t.dependsOn ?? []).includes(tech.id));

const canonical = canonicalKeyFor(tech.name);
const theme = canonical ? themeByKey(canonical) : undefined;
const elsewhere = canonical
  ? INDUSTRIES.filter((i) => i.slug !== industry.slug)
      .map((i) => {
        const match = i.technologies.find((t) => canonicalKeyFor(t.name) === canonical);
        return match ? { industry: i, tech: match } : null;
      })
      .filter((x): x is { industry: (typeof INDUSTRIES)[number]; tech: typeof tech } => x !== null)
  : [];

const pageUrl = new URL(`/radar/${industry.slug}/${slugify(tech.name)}/`, Astro.site).href;
const ogUrl = new URL(`/radar/og/${industry.slug}/${slugify(tech.name)}.png`, Astro.site).href;
const description = `${tech.summary} Placed in "${ringLabel}" on the ${industry.name} Emerging Technology & Innovation Radar.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${tech.name} — ${ringLabel}`,
  description,
  url: pageUrl,
  image: ogUrl,
  datePublished: industry.edition.published,
  author: { '@type': 'Person', name: 'Shailesh Kumar', url: 'https://vantessence.com/' },
  publisher: { '@type': 'Person', name: 'Shailesh Kumar' },
  about: { '@type': 'DefinedTerm', name: tech.name, description: tech.summary, inDefinedTermSet: `${industry.name} Technology Radar` },
  keywords: [...tech.tags, industry.name, ringLabel, quadrant?.name].filter(Boolean).join(', '),
  isPartOf: { '@type': 'Dataset', name: `Emerging Technology & Innovation Radar — ${industry.name}`, url: new URL(`/radar/?industry=${industry.slug}`, Astro.site).href },
};
---
<BaseLayout title={`${tech.name} · ${industry.name} Radar`} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <article class="mx-auto max-w-3xl px-6 pt-16 pb-24">
    <nav aria-label="Breadcrumb" class="text-xs text-mist">
      <a href="/radar/" class="hover:text-white">Radar</a>
      <span class="mx-1.5">/</span>
      <a href={`/radar/?industry=${industry.slug}`} class="hover:text-white">{industry.name}</a>
    </nav>

    <div class="mt-5 flex flex-wrap gap-2 text-xs">
      <span class="rounded-full bg-violet-500/20 px-2.5 py-1 text-violet-200">{quadrant?.code} · {quadrant?.name}</span>
      <span class="rounded-full bg-cyan-500/20 px-2.5 py-1 text-cyan-200">{ringLabel}</span>
      <span class="rounded-full bg-amber-500/20 px-2.5 py-1 text-amber-200">{momentum?.glyph} {momentum?.label}</span>
      <span class="rounded-full border border-white/15 px-2.5 py-1 text-mist">Horizon: {tech.timeHorizon}</span>
    </div>

    <h1 class="mt-5 font-display text-3xl font-semibold text-white sm:text-4xl">{tech.name}</h1>
    <p class="mt-3 text-lg italic leading-relaxed text-mist">{tech.summary}</p>

    <div class="prose prose-invert mt-8 max-w-none">
      <p class="text-base leading-relaxed text-mist">{tech.brief}</p>
    </div>

    {tech.evidence?.length && (
      <section class="mt-10">
        <h2 class="font-display text-sm font-semibold uppercase tracking-[0.3em] text-cyan-400">Signals behind this placement</h2>
        <ul class="mt-3 space-y-2">
          {tech.evidence.map((e) => (
            <li class="flex gap-2 text-sm leading-relaxed text-mist"><span class="text-cyan-400">—</span><span>{e}</span></li>
          ))}
        </ul>
      </section>
    )}

    {(dependsOn.length > 0 || enables.length > 0) && (
      <section class="mt-10">
        <h2 class="font-display text-sm font-semibold uppercase tracking-[0.3em] text-mist">Sequencing</h2>
        {dependsOn.length > 0 && (
          <p class="mt-3 text-sm text-mist">
            <span class="font-semibold text-amber-300">Builds on</span>{' '}
            {dependsOn.map((d, i) => (
              <>
                {i > 0 && ', '}
                <a href={routeFor(industry.slug, d!.name)} class="underline decoration-dotted hover:text-white">{d!.name}</a>
              </>
            ))}
          </p>
        )}
        {enables.length > 0 && (
          <p class="mt-2 text-sm text-mist">
            <span class="font-semibold text-emerald-300">Enables</span>{' '}
            {enables.map((d, i) => (
              <>
                {i > 0 && ', '}
                <a href={routeFor(industry.slug, d.name)} class="underline decoration-dotted hover:text-white">{d.name}</a>
              </>
            ))}
          </p>
        )}
      </section>
    )}

    {elsewhere.length > 0 && (
      <section class="mt-10">
        <h2 class="font-display text-sm font-semibold uppercase tracking-[0.3em] text-mist">
          {theme?.label} across other industries
        </h2>
        <p class="mt-2 text-sm text-mist">{theme?.blurb}</p>
        <div class="mt-4 space-y-2">
          {elsewhere.map(({ industry: other, tech: t }) => (
            <a href={routeFor(other.slug, t.name)} class="glass block rounded-xl p-4 transition hover:bg-white/10">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-xs font-semibold uppercase tracking-wide text-cyan-400">{other.name}</span>
                <span class="rounded-full bg-white/10 px-2.5 py-1 text-xs text-mist">{RINGS.find((r) => r.id === t.ring)?.label}</span>
              </div>
              <p class="mt-1.5 text-sm font-semibold text-white">{t.name}</p>
              <p class="mt-1 text-xs text-mist">{t.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="mt-10 flex flex-wrap gap-2 text-xs text-mist">
      {tech.tags.map((tag) => <span class="rounded-full border border-white/10 px-2.5 py-1">{tag}</span>)}
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-sm text-mist">
      <p>
        From the <a href={`/radar/?industry=${industry.slug}&tech=${tech.id}`} class="text-cyan-300 underline">{industry.name} Emerging Technology &amp; Innovation Radar</a>,
        {' '}{industry.edition.label}, published {industry.edition.published}.
      </p>
      <p class="mt-2 text-xs text-mist/70">An independent, industry-agnostic radar curated by Shailesh Kumar.</p>
    </div>
  </article>
</BaseLayout>
