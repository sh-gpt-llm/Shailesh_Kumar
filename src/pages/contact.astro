---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---
<BaseLayout title="Contact" description="Get in touch with Shailesh Kumar for advisory, consulting, and speaking engagements.">
  <section class="mx-auto max-w-3xl px-6 py-24 text-center">
    <p class="reveal text-xs font-semibold uppercase tracking-[0.4em] text-cyan-400">Let's Connect</p>
    <h1 class="reveal mt-6 font-display text-4xl font-semibold text-white sm:text-6xl">
      {site.contact.headline}
    </h1>
    <p class="reveal mt-6 text-lg leading-relaxed text-mist">
      {site.contact.description}
    </p>

    <div class="reveal mt-12 grid gap-5 sm:grid-cols-2">
      <a href={`mailto:${site.contact.email}`} class="glow-border glass rounded-2xl p-8 text-left transition hover:-translate-y-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-400">Email</p>
        <p class="mt-3 font-display text-lg font-semibold text-white">{site.contact.email}</p>
      </a>
      <a href={site.contact.linkedin} target="_blank" rel="noopener" class="glow-border glass rounded-2xl p-8 text-left transition hover:-translate-y-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-400">LinkedIn</p>
        <p class="mt-3 font-display text-lg font-semibold text-white">{site.contact.linkedinLabel}</p>
      </a>
    </div>

    <p class="reveal mt-10 text-sm text-mist">{site.contact.location}</p>
  </section>
</BaseLayout>
