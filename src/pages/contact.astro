---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Get in touch with Shailesh Kumar for advisory, consulting, and speaking engagements.">
  <section class="mx-auto max-w-3xl px-6 py-24 text-center">
    <p class="reveal text-xs font-semibold uppercase tracking-[0.4em] text-cyan-400">Let's Connect</p>
    <h1 class="reveal mt-6 font-display text-4xl font-semibold text-white sm:text-6xl">
      Open to advisory, speaking &amp; <span class="gradient-text">bold collaborations</span>
    </h1>
    <p class="reveal mt-6 text-lg leading-relaxed text-mist">
      Whether it's enterprise architecture governance, an AI operating model, or a digital core modernization
      program — I'd love to hear about what you're building.
    </p>

    <div class="reveal mt-12 grid gap-5 sm:grid-cols-2">
      <a href="mailto:sh.1810.kr@gmail.com" class="glow-border glass rounded-2xl p-8 text-left transition hover:-translate-y-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-400">Email</p>
        <p class="mt-3 font-display text-lg font-semibold text-white">sh.1810.kr@gmail.com</p>
      </a>
      <a href="https://www.linkedin.com/in/shailesh-18-kr-2561281069" target="_blank" rel="noopener" class="glow-border glass rounded-2xl p-8 text-left transition hover:-translate-y-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-400">LinkedIn</p>
        <p class="mt-3 font-display text-lg font-semibold text-white">/in/shailesh-18-kr</p>
      </a>
    </div>

    <p class="reveal mt-10 text-sm text-mist">Based in Bengaluru, Karnataka, India · Working with teams globally</p>
  </section>
</BaseLayout>
