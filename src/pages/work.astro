---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { competencies } from '../data/career';

const offerings = [
  {
    title: 'Enterprise Architecture Advisory',
    detail: 'Design Authority setup, reference architectures, governance guardrails, and portfolio rationalization for complex, regulated enterprises.',
  },
  {
    title: 'AI Strategy & Industrialization',
    detail: 'Moving GenAI and Agentic AI from pilot to production — operating models, responsible AI controls, and investment governance (the TIE framework).',
  },
  {
    title: 'Digital Core & ERP Modernization',
    detail: 'Multi-ERP harmonization, SAP HANA transformation, and carve-out/M&A technology separation at regulatory-grade speed.',
  },
  {
    title: 'Innovation Portfolio Design',
    detail: 'Technology radar, Horizon-2/Horizon-3 prioritization, and structured triage of emerging tech investment.',
  },
  {
    title: 'Digital Health & RWD/RWE Architecture',
    detail: 'Decentralized clinical trials, digital biomarkers, SaMD ecosystems and interoperability strategy for life sciences.',
  },
  {
    title: 'Executive Advisory & Speaking',
    detail: 'Board and leadership-level briefings on AI operating models, cloud strategy, and technology-driven competitive positioning.',
  },
];
---
<BaseLayout title="What I Do" description="Enterprise architecture advisory, AI strategy, and digital transformation consulting from Shailesh Kumar.">
  <section class="mx-auto max-w-4xl px-6 pt-20 pb-8 text-center">
    <p class="reveal text-xs font-semibold uppercase tracking-[0.4em] text-cyan-400">What I Do</p>
    <h1 class="reveal mt-6 font-display text-4xl font-semibold text-white sm:text-6xl">
      Turning strategy into <span class="gradient-text">production-grade capability</span>
    </h1>
    <p class="reveal mt-6 text-lg leading-relaxed text-mist">
      I work at the intersection of enterprise architecture, AI industrialization, and capital investment governance —
      helping complex, regulated organizations modernize with discipline and speed.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <SectionHeading eyebrow="Engagements" title="How I can help" align="center" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {offerings.map((o, i) => (
        <div class="reveal glass glow-border rounded-2xl p-7" style={`transition-delay:${i * 60}ms`}>
          <h3 class="font-display text-lg font-semibold text-white">{o.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-mist">{o.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <SectionHeading eyebrow="Depth" title="Full capability map" align="center" />
    <div class="mt-10 grid gap-4">
      {competencies.map((c, i) => (
        <div class="reveal glass rounded-2xl p-6 sm:flex sm:items-center sm:justify-between sm:gap-8" style={`transition-delay:${i * 40}ms`}>
          <h3 class="font-display shrink-0 text-base font-semibold text-white sm:w-1/3">{c.area}</h3>
          <p class="mt-2 text-sm text-mist sm:mt-0">{c.scope}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-28 text-center">
    <div class="reveal glow-border glass rounded-3xl p-10 sm:p-14">
      <h2 class="font-display text-2xl font-semibold text-white sm:text-3xl">Have a transformation problem worth solving?</h2>
      <a href="/contact" class="mt-6 inline-block rounded-full bg-white px-8 py-3 text-sm font-semibold text-ink transition hover:scale-105">
        Start a Conversation
      </a>
    </div>
  </section>
</BaseLayout>
