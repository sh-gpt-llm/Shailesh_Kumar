---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const timeline = (await getCollection('timeline')).sort((a, b) => a.data.order - b.data.order).map((e) => e.data);
const competencies = (await getCollection('competencies')).sort((a, b) => a.data.order - b.data.order).map((e) => e.data);
const firstRole = timeline[timeline.length - 1];
const currentRole = timeline[0];
---
<BaseLayout title="Home">
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-24 sm:pt-28">
    <p class="reveal text-xs font-semibold uppercase tracking-[0.4em] text-cyan-400">
      {site.hero.eyebrow}
    </p>
    <h1 class="reveal mt-6 max-w-4xl font-display text-5xl font-semibold leading-[1.05] text-white sm:text-7xl">
      {site.hero.headline}
    </h1>
    <p class="reveal mt-8 max-w-2xl text-lg leading-relaxed text-mist">
      {site.hero.description} From a first engineering job on a telecom
      network operations desk in {firstRole.year}, to shaping enterprise AI strategy in {currentRole.year}.
    </p>
    <div class="reveal mt-10 flex flex-wrap gap-4">
      <a href="/journey" class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-ink transition hover:scale-105">
        See My Journey
      </a>
      <a href="/writing" class="glow-border glass rounded-full px-6 py-3 text-sm font-semibold text-white transition hover:scale-105">
        Explore the Writing
      </a>
    </div>

    <div class="reveal mt-16 grid grid-cols-2 gap-6 border-t border-white/5 pt-10 sm:grid-cols-4">
      {site.heroStats.map((stat) => (
        <div>
          <p class="font-display text-3xl font-semibold gradient-text sm:text-4xl">{stat.value}</p>
          <p class="mt-2 text-xs text-mist">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Current focus -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <SectionHeading eyebrow="Right Now" title={currentRole.title} description={currentRole.org} />
    <p class="reveal mt-6 max-w-3xl text-base leading-relaxed text-mist">{currentRole.summary}</p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {currentRole.highlights.map((h, i) => (
        <div class="reveal glass glow-border rounded-2xl p-6" style={`transition-delay:${i * 80}ms`}>
          <p class="text-sm leading-relaxed text-slate-200">{h}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- What I do -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <SectionHeading eyebrow="Core Competencies" title="Where I create the most value" />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {competencies.map((c, i) => (
        <div class="reveal glass glow-border rounded-2xl p-6" style={`transition-delay:${i * 50}ms`}>
          <h3 class="font-display text-base font-semibold text-white">{c.area}</h3>
          <p class="mt-3 text-sm leading-relaxed text-mist">{c.scope}</p>
        </div>
      ))}
    </div>
    <a href="/work" class="reveal mt-8 inline-flex items-center gap-2 text-sm font-semibold text-cyan-300 hover:text-white">
      Full breakdown of what I do →
    </a>
  </section>

  <!-- Featured writing -->
  {posts.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-20">
      <SectionHeading eyebrow="Latest Thinking" title="Research, patterns & strategy notes" description="Blogs, architecture patterns, research and consulting ideas — written and published without a single line of code." />
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {posts.map((post) => (
          <PostCard
            href={`/writing/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            category={post.data.category}
            date={post.data.date}
          />
        ))}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-6 pb-28">
    <div class="reveal glow-border glass rounded-3xl p-10 text-center sm:p-16">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">
        Let's talk enterprise architecture, AI strategy, or your next transformation.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-mist">
        Open to advisory, speaking, consulting engagements and strategic collaborations.
      </p>
      <a href="/contact" class="mt-8 inline-block rounded-full bg-white px-8 py-3 text-sm font-semibold text-ink transition hover:scale-105">
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
