---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INDUSTRIES } from '../../data/radar/industries';
import { DIMENSIONS } from '../../data/nexa/framework';
import { CRITERIA } from '../../data/earb/model';

const totalTech = INDUSTRIES.reduce((n, i) => n + i.technologies.length, 0);
const pageUrl = new URL('/practice/', Astro.site).href;

const instruments = [
  {
    stage: 'Scout',
    name: 'Emerging Technology & Innovation Radar',
    href: '/radar/',
    question: 'What is out there, and what do we think of it?',
    body: `${totalTech} technologies across ${INDUSTRIES.length} industries, each placed in Adopt, Trial, Assess or Hold with a written brief explaining the call, the signals behind it, and what would move it.`,
    stat: `${totalTech} assessments`,
    secondary: [
      { label: 'How to read it', href: '/radar/how-it-works/' },
      { label: 'Raw data', href: '/radar/data.json' },
    ],
  },
  {
    stage: 'Decide',
    name: 'NEXA — technology assessment framework',
    href: '/nexa/',
    question: 'Should we do this specific thing?',
    body: `A vendor, product or capability gap scored across ${DIMENSIONS.length} weighted dimensions against a bar set by the size of the commitment. Four verdicts, the reasoning, and the single thing that would change it.`,
    stat: `${DIMENSIONS.length} dimensions`,
    secondary: [
      { label: 'The framework', href: '/nexa/framework/' },
      { label: 'Raw data', href: '/nexa/data.json' },
    ],
  },
  {
    stage: 'Govern',
    name: 'EARB — architecture review board',
    href: '/earb/',
    question: 'Is it ready to be decided, and who should decide it?',
    body: `Triage so that only the right things reach a board, ${CRITERIA.length} readiness criteria so submissions are reviewable, six decision outcomes instead of two, and the questions the board will actually ask.`,
    stat: `${CRITERIA.length} readiness criteria`,
    secondary: [
      { label: 'The operating model', href: '/earb/framework/' },
      { label: 'Raw data', href: '/earb/data.json' },
    ],
  },
];

const faq = [
  {
    q: 'How does enterprise architecture reduce technical debt?',
    a: 'Technical debt accumulates one unexamined decision at a time. It is rarely created by a single bad choice; it is created by many reasonable choices made without anyone asking what they duplicate, what they replace, or what it costs to reverse them. Architecture reduces debt by putting those three questions in front of every decision, consistently, before the commitment rather than after — and by making the answers a matter of record rather than memory.',
  },
  {
    q: 'What is the difference between an architecture framework and an architecture instrument?',
    a: 'A framework describes how to think. An instrument is something you actually use on a Tuesday afternoon to reach a decision faster and more consistently than you would have alone. Frameworks are taught; instruments are operated. Most architecture functions have plenty of the first and almost none of the second, which is why their output is documents rather than decisions.',
  },
  {
    q: 'What is application rationalisation, and where does it fit?',
    a: 'Application rationalisation is the disciplined reduction of an existing estate — retiring, consolidating and replacing what is already running. It is the counterpart to scouting, deciding and governing new technology, and it is usually where the largest and most measurable savings sit, because the estate you already own is where the cost actually is.',
  },
  {
    q: 'Are these instruments free to use?',
    a: 'Yes. Every method is published in full, including the weights, the scoring rules and the decision bands, and each is available as machine-readable JSON. They are free to adopt, adapt or argue with, with attribution. Nothing requires an account and nothing you enter leaves your browser.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Enterprise Architecture in Practice',
    description:
      'Three published, working instruments for enterprise architecture: a technology radar, a technology assessment framework, and an architecture review board operating model.',
    url: pageUrl,
    author: { '@type': 'Person', name: 'Shailesh Kumar', url: 'https://vantessence.com/' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: instruments.map((i, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: i.name,
        description: i.question,
        url: new URL(i.href, Astro.site).href,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout
  title="Enterprise Architecture in Practice"
  description="Three published, working instruments for enterprise architecture — a technology radar, a decision framework, and an architecture review board operating model. Free, open, and built to reduce technical debt by making decisions consistent."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <section class="mx-auto max-w-4xl px-6 pt-16 sm:pt-24">
    <p class="text-xs font-semibold uppercase tracking-[0.4em] text-amber-400">Practice</p>
    <h1 class="mt-4 font-display text-3xl font-semibold text-white sm:text-5xl">
      Enterprise architecture, <span class="gradient-text">as instruments.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mist">
      Most architecture functions produce documents. The ones that change anything produce instruments — repeatable
      things that make decisions faster, more consistent, and defensible six months later when nobody remembers the
      meeting.
    </p>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-mist">
      These are three of mine, built and published in full. Not slideware about the art of the possible — working
      instruments with the method, the weights and the decision rules open to inspection, because a framework you
      cannot audit is just an opinion with a diagram.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-12">
    <h2 class="font-display text-sm font-semibold uppercase tracking-[0.3em] text-mist">Scout · Decide · Govern</h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-mist">
      They chain. The radar supplies the technology positions that NEXA weighs and that EARB tests submissions against.
      A NEXA verdict becomes evidence in a board paper. One estate view, three decision points.
    </p>

    <div class="mt-8 space-y-5">
      {instruments.map((i) => (
        <article class="glass glow-border rounded-3xl p-7">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-400">{i.stage}</p>
              <h3 class="mt-2 font-display text-xl font-semibold text-white sm:text-2xl">
                <a href={i.href} class="transition hover:text-cyan-200">{i.name}</a>
              </h3>
              <p class="mt-2 text-sm italic text-mist">{i.question}</p>
            </div>
            <span class="shrink-0 rounded-full border border-white/15 px-3 py-1 text-xs font-semibold text-mist">{i.stat}</span>
          </div>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-mist">{i.body}</p>
          <div class="mt-5 flex flex-wrap items-center gap-4">
            <a href={i.href} class="rounded-full bg-gradient-to-r from-violet-500 to-cyan-400 px-5 py-2 text-sm font-semibold text-ink transition hover:opacity-90">
              Open
            </a>
            {i.secondary.map((sec) => (
              <a href={sec.href} class="text-sm text-mist underline decoration-dotted transition hover:text-white">{sec.label}</a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-12">
    <h2 class="font-display text-2xl font-semibold text-white">Why this, rather than more documents</h2>
    <p class="mt-5 text-base leading-relaxed text-mist">
      Technical debt is rarely created by one bad decision. It accumulates through many reasonable ones taken without
      anybody asking what they duplicate, what they replace, or what it would cost to reverse them. By the time it is
      visible on a balance sheet, the people who made those choices have moved on and the reasoning is gone.
    </p>
    <p class="mt-4 text-base leading-relaxed text-mist">
      The same is true of application rationalisation. Estates do not become sprawling because somebody decided they
      should; they sprawl because nothing in the process ever required a new thing to displace an old one.
    </p>
    <p class="mt-4 text-base leading-relaxed text-mist">
      Instruments fix this at the only point where it is cheap — before the commitment. Ask what this duplicates. Ask
      what gets switched off. Ask what it costs to walk away. Ask the same questions every time, write down the answers,
      and the estate stops accumulating decisions nobody can explain.
    </p>
    <p class="mt-4 text-base leading-relaxed text-mist">
      None of that requires a transformation programme. It requires asking a consistent set of questions and recording
      the answers — which is all any of these three actually do.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-12">
    <h2 class="font-display text-2xl font-semibold text-white">Common questions</h2>
    <dl class="mt-6 space-y-6">
      {faq.map((f) => (
        <div>
          <dt class="font-display text-base font-semibold text-white">{f.q}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-mist">{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-20">
    <div class="rounded-3xl border border-dashed border-white/15 p-7">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-mist">Next</p>
      <h2 class="mt-3 font-display text-xl font-semibold text-white">Application rationalisation</h2>
      <p class="mt-2 text-sm leading-relaxed text-mist">
        All three instruments above look forward, at things you might add. The estate you already run is where the debt
        actually lives, and where the measurable savings are. That is the fourth instrument, and it is in progress.
      </p>
    </div>
  </section>
</BaseLayout>
