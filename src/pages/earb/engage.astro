---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ENGAGE_QUESTIONS, LEVELS, ENGAGE_RULES, ENGAGE_FAQ } from '../../data/earb/engagement';

const pageUrl = new URL('/earb/engage/', Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to decide whether your project needs enterprise architecture engagement',
    description:
      'A ten-question triage that routes an initiative to no architecture engagement, a lightweight review by a single architect, or a formal architecture review board.',
    url: pageUrl,
    totalTime: 'PT2M',
    author: { '@type': 'Person', name: 'Shailesh Kumar', url: 'https://vantessence.com/' },
    step: ENGAGE_QUESTIONS.map((q, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: q.topic,
      text: `${q.question} ${q.hint} ${q.why}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: ENGAGE_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'EARB', item: new URL('/earb/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Do I need EA?', item: pageUrl },
    ],
  },
];
---
<BaseLayout
  title="Do I need enterprise architecture involvement?"
  description="Ten questions that tell you whether your initiative needs no architecture engagement, a lightweight review by one architect, or a formal architecture review board — with the reasoning behind the answer."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <section class="mx-auto max-w-4xl px-6 pt-16 pb-8">
    <nav class="text-xs text-mist">
      <a href="/earb/" class="transition hover:text-white">EARB</a>
      <span class="mx-2 text-mist/50">/</span>
      <span class="text-white">Do I need EA?</span>
    </nav>
    <p class="mt-8 text-xs font-semibold uppercase tracking-[0.4em] text-amber-400">Engagement triage</p>
    <h1 class="mt-4 font-display text-3xl font-semibold text-white sm:text-5xl">
      Do you actually need <span class="gradient-text">an architect?</span>
    </h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-mist">
      Teams waste weeks either queuing for a review they never needed, or discovering far too late that they needed one.
      Ten questions settle it: no engagement, a lightweight review by a single architect, or a formal review board.
    </p>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-mist/80">
      The highest trigger wins, and answering “not sure” raises the level rather than lowering it. Nothing is sent
      anywhere — there is no name or email field, because there is nothing to send.
    </p>
  </section>

  {/* Server-rendered so the triage logic is readable without JavaScript; the app replaces this on mount. */}
  <div id="earb-engage">
    <section class="mx-auto max-w-4xl px-6 pb-10">
      <h2 class="font-display text-sm font-semibold uppercase tracking-[0.3em] text-mist">The three levels</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {LEVELS.map((l) => (
          <div class="rounded-2xl border p-5" style={`border-color:${l.color}44;background:${l.color}10`}>
            <p class="text-xs font-semibold uppercase tracking-wide" style={`color:${l.color}`}>{l.label}</p>
            <p class="mt-2 text-xs leading-relaxed text-mist">{l.summary}</p>
            <p class="mt-2 text-[11px] text-mist/70">{l.sla}</p>
          </div>
        ))}
      </div>

      <h2 class="mt-12 font-display text-sm font-semibold uppercase tracking-[0.3em] text-mist">How the level is decided</h2>
      <ol class="mt-3 space-y-1.5">
        {ENGAGE_RULES.map((r) => (
          <li class="text-sm text-mist"><span class="font-mono text-xs text-cyan-400">{r.order}.</span> If {r.condition} → <strong class="text-white">{r.result}</strong></li>
        ))}
      </ol>

      <h2 class="mt-12 font-display text-sm font-semibold uppercase tracking-[0.3em] text-mist">The {ENGAGE_QUESTIONS.length} questions</h2>
      <div class="mt-4 space-y-6">
        {ENGAGE_QUESTIONS.map((q, i) => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-cyan-400">{i + 1}. {q.topic}</p>
            <h3 class="mt-2 font-display text-base font-semibold text-white">{q.question}</h3>
            <p class="mt-1.5 text-sm text-mist">{q.hint}</p>
            <ul class="mt-3 space-y-1.5">
              {q.options.map((o) => (
                <li class="text-sm text-mist">
                  <span class="font-mono text-[10px] uppercase text-mist/60">
                    {o.level === 'none' ? 'none' : o.level === 'single' ? 'single' : o.level === 'board' ? 'board' : 'unsure'}
                  </span>
                  {' — '}{o.text}
                </li>
              ))}
            </ul>
            <p class="mt-3 text-xs leading-relaxed text-mist/70">{q.why}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <section class="mx-auto max-w-3xl px-6 py-12">
    <h2 class="font-display text-2xl font-semibold text-white">Common questions</h2>
    <dl class="mt-6 space-y-6">
      {ENGAGE_FAQ.map((f) => (
        <div>
          <dt class="font-display text-base font-semibold text-white">{f.q}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-mist">{f.a}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-10 text-xs leading-relaxed text-mist/60">
      Thresholds here are deliberately relative rather than absolute. Every organisation has to set its own numbers for
      cost, user counts and contract value — the structure is what transfers, not the figures.
    </p>
  </section>
</BaseLayout>

<script>
  import { initEarbEngage } from '../../scripts/earb-engage';
  initEarbEngage();
</script>
